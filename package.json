{
  "name": "dsh-openai-subscription",
  "type": "module",
  "scripts": {
    "build:auth": "node scripts/build-auth.mjs",
    "prepack": "npm run build:auth",
    "test": "node --test tests/*.test.mjs provider/test/*.test.mjs",
    "test:auth": "node --test vendor/siwc-local/test/*.test.mjs"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/cordis": "4.0.5-alpha.1"
  },
  "version": "0.1.0",
  "description": "Connect DeepSeek Harness to a ChatGPT subscription through official Sign in with ChatGPT.",
  "bin": {
    "dsh-openai": "./cli.mjs"
  },
  "main": "./provider/index.mjs",
  "exports": {
    ".": "./provider/index.mjs",
    "./provider": "./provider/index.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "files": [
    "cli.mjs",
    "auth.mjs",
    "paths.mjs",
    "capabilities.mjs",
    "keychain.mjs",
    "keychain-helper.swift",
    "cordis.patch.yml",
    "provider/index.mjs",
    "provider/wire.mjs",
    "vendor/siwc-local/dist",
    "vendor/siwc-local/src",
    "vendor/siwc-local/LICENSE",
    "vendor/siwc-local/THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teilomillet/dsh-openai-subscription.git"
  },
  "homepage": "https://github.com/teilomillet/dsh-openai-subscription#readme",
  "bugs": {
    "url": "https://github.com/teilomillet/dsh-openai-subscription/issues"
  }
}
